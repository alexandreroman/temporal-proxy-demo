# Copy to .env and fill in before deploying.
# .env is git-ignored; .env.example is the documented template.

# Temporal Cloud Namespace, short name — the part before the dot in the
# fully-qualified Namespace name (quickstart.a1b2c -> quickstart).
TEMPORAL_CLOUD_NAMESPACE=

# Temporal Cloud account id — the part after the dot in the
# fully-qualified Namespace name (quickstart.a1b2c -> a1b2c).
TEMPORAL_ACCOUNT=

# The demo also needs a client certificate, which lives on disk rather
# than in this file: put it in k8s/certs/ as client.pem and client.key,
# from where `make` builds the Secret temporal-proxy mounts. The CA that
# signed it must be registered on the Namespace as an accepted client
# CA. See README.md.
