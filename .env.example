# Copy to .env and fill in before running the Temporal Cloud scenario.
# .env is git-ignored; .env.example is the documented template.

# Which scenario configuration Compose mounts into temporal-proxy.
# `make use-local` and `make use-cloud` rewrite this single line.
PROXY_CONFIG=./proxy/local.yaml

# Temporal Cloud Namespace, short name — the part before the dot in the
# fully-qualified Namespace name (quickstart.a1b2c -> quickstart).
TEMPORAL_CLOUD_NAMESPACE=

# Temporal Cloud account id — the part after the dot in the
# fully-qualified Namespace name (quickstart.a1b2c -> a1b2c).
TEMPORAL_ACCOUNT=

# The cloud scenario also needs a client certificate, which lives on disk
# rather than in this file: temporal-proxy expects proxy/certs/client.pem
# and proxy/certs/client.key. The CA that signed them must be registered
# on the Namespace as an accepted client CA. See README.md.
