# Copy to .env and fill in before running the Temporal Cloud scenario.
# .env is git-ignored; .env.example is the documented template.

# Short Namespace name used by the Worker and the starter. The proxy
# rewrites it to the fully-qualified upstream name.
TEMPORAL_NAMESPACE=default

# Temporal Cloud account id — the part after the dot in the
# fully-qualified Namespace name (quickstart.a1b2c -> a1b2c).
TEMPORAL_ACCOUNT=

# Temporal Cloud API key. API key authentication must be enabled on the
# Namespace; Namespaces default to mTLS.
TEMPORAL_API_KEY=
