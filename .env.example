# Copy to .env and fill in before deploying.

# Temporal Cloud Namespace, short name — the part before the dot in the
# fully-qualified Namespace name (quickstart.a1b2c -> quickstart).
TEMPORAL_CLOUD_NAMESPACE=

# Temporal Cloud account id — the part after the dot in the
# fully-qualified Namespace name (quickstart.a1b2c -> a1b2c).
TEMPORAL_ACCOUNT=

# A client certificate is also required, in k8s/certs/: see README.md.

# The secret every Namespace's payload wrapping key is derived from.
# Generate one with `openssl rand -base64 32` and append it as
# KMS_MASTER_SECRET=... — HKDF extracts entropy from this value rather
# than adding any, so a memorable phrase here is directly
# brute-forceable. Losing it loses every payload ever sealed under it,
# with no recovery path.
