# Keep the build context down to what the image actually compiles.
.git
.github
.claude

# Local environment — never in the build context
.env*

# Build and test output
bin/
tmp/
*.test
coverage.out

# Not part of the build: deployment manifests, the demo's own
# documentation, and the client certificate the runtime image never
# copies in.
docs/
k8s/
proxy/
.superpowers/
*.md
Makefile
LICENSE
.casper.json
.DS_Store
