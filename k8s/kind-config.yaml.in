# This worktree's Kind cluster. k8s/kind-config.yaml is rendered from
# k8s/kind-config.yaml.in with this worktree's TRAEFIK_PORT, by
# `make worktree-init`, or by `make cluster-create` when it is absent.
# It is not committed — see .gitignore.
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
nodes:
  # One node: kind lets workloads run on a lone control-plane node.
  - role: control-plane
    # The only port this cluster publishes. Traefik answers on NodePort
    # 30080; everything the demo exposes goes through it.
    extraPortMappings:
      - containerPort: 30080
        hostPort: @TRAEFIK_PORT@
        # kind publishes on 0.0.0.0 otherwise, and the Web UI reading through
        # temporal-proxy shows payloads in cleartext: keep it on this machine.
        listenAddress: 127.0.0.1
