# Build output
/bin/
/tmp/

# Local environment — never commit credentials
.env
.env.local

# Client certificate for the Cloud scenario — never commit key material
/proxy/certs/*
!/proxy/certs/.gitkeep

# Per-worktree host ports — written by `make worktree-init`
/compose.override.yaml

# Go
*.test
/coverage.out

# macOS
.DS_Store

# Scenario walkthroughs — kept out of version control
/docs/
