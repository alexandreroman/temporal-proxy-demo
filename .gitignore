# Build output
/bin/
/tmp/

# Local environment — never commit credentials
.env

# Temporal Cloud client certificate — never commit key material
/proxy/certs/*
!/proxy/certs/.gitkeep

# Per-worktree cluster config — written by `make worktree-init`
/k8s/kind-config.yaml

# Go
*.test
/coverage.out

# macOS
.DS_Store

# Scenario walkthroughs — kept out of version control
/docs/
